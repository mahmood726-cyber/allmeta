  416: def _cue_precedes(text: str, effect: dict, cues: list, n_sentences: int,
  417:                   single_outcome: bool = False) -> bool:
  418:     """Does an outcome cue appear in the `n_sentences` ENDING AT this effect?
  419: 
  420:     Backward only, never forward. In clinical prose the outcome is named before its
  421:     estimate -- "Death from any cause occurred in ... (hazard ratio 0.83)" -- so a
  422:     window that reaches PAST the effect will swallow the NEXT outcome's label and
  423:     scope the wrong number. That is not hypothetical: it is what plant 5 caught.
  424:     """
  425:     cs = effect.get("char_start")
  426:     if cs is None:
  427:         return False
  428:     head = text[max(0, cs - 900):cs]
  429:     bounds = [m.end() for m in _SENT_END.finditer(head)]
  430:     start = bounds[-n_sentences] if len(bounds) >= n_sentences else 0
  431:     clause = head[start:]
  432:     window = (clause + (effect.get("source_text") or "")).lower()
