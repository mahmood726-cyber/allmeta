 1247: def _names_trial(text: str, req: Request) -> bool:
 1248:     """Does this document actually name the trial? Acronyms are matched on a word
 1249:     boundary so that 'SOLVD' does not match inside another token, and the NCT id
 1250:     counts as a name."""
 1251:     low = (text or "").lower()
 1252:     if req.nct and req.nct.lower() in low:
 1253:         return True
 1254:     for n in [req.trial] + list(req.aliases):
 1255:         if not n:
 1256:             continue
 1257:         pat = re.escape(n.lower()).replace(r"\-", r"[\-\s]?")
 1258:         if re.search(r"(?<![a-z0-9])" + pat + r"(?![a-z0-9])", low):
 1259:             return True
 1260:     return False

