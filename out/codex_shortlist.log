    "FIGURE-1", "APPENDIX-1", "VERSION-1", "VERSION-2", "STUDY-1", "STUDY-2",
    "OMEGA-3", "IL-6", "IL-2", "PD-1", "PD-L1", "CD-4", "CD-8", "TNF-A",
