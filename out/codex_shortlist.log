import ast, pathlib
files = [
'oa68k/net.py','oa68k/harvest.py','oa68k/jats.py','oa68k/config.py','oa68k/fda.py','oa68k/fulltext.py','oa68k/preextract.py','oa68k/registry_full.py','oa68k/registry_ids.py','oa68k/crosswalk.py','oa68k/epmc_seed.py','oa68k/ingest.py','oa68k/parse_detect.py','oa68k/detect3.py','oa68k/keyscan.py','oa68k/linkmap.py','oa68k/refmatch.py','oa68k/refjoin.py','oa68k/isrctn.py','oa68k/ladder_store.py','oa68k/figscan.py','oa68k/forestvision.py','oa68k/forestscore.py','oa68k/trial_index.py','oa68k/aact_ext.py','oa68k/obtainability.py','oa68k/ladder.py','oa68k/ladder_bench.py']

def sig(lines, lineno):
    out=[]; depth=0; seen=False
    for line in lines[lineno-1:]:
        s=line.rstrip('\\n')
        out.append(s.strip())
        for ch in s:
            if ch in '([{': depth+=1; seen=True
            elif ch in ')]}': depth-=1
        if s.rstrip().endswith(':') and depth<=0:
            break
    return ' '.join(out).rstrip(':')

for f in files:
    src=pathlib.Path(f).read_text(encoding='utf-8')
    lines=src.splitlines(True)
    tree=ast.parse(src)
    print('\\n'+f)
    for node in tree.body:
        if isinstance(node, (ast.FunctionDef, ast.ClassDef)) and not node.name.startswith('_'):
            print('  '+sig(lines,node.lineno))
            if isinstance(node, ast.ClassDef):
                for sub in node.body:
                    if isinstance(sub, ast.FunctionDef) and not sub.name.startswith('_'):
                        print('    '+sig(lines,sub.lineno))
