NCBI_API_KEY = os.environ.get("NCBI_API_KEY", "")

# âš ï¸ NCBI's limit is PER API KEY, not per IP: 3 req/s keyless, 10 req/s with a key.
# Two nodes sharing ONE key therefore share ONE 10/s budget â€” running each at 9/s
