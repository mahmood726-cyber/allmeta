"C:\\WINDOWS\\System32\\WindowsPowerShell\\v1.0\\powershell.exe" -Command "@'
import ast, json, os, re
from pathlib import Path
root=Path(r'F:\\tr-build\\ladder')
reg=Path(r'F:\\allmeta\\regulatory')
patterns=['requests.','urllib','http','efetch','europepmc','ebi.ac.uk','clinicaltrials.gov','accessdata.fda.gov','ema.europa.eu','pdfminer','PyPDF','fitz','BeautifulSoup','lxml','table']

def read_text(p):
    try:
        return p.read_text(encoding='utf-8')
    except UnicodeDecodeError:
        return p.read_text(encoding='utf-8-sig', errors='replace')

def def_signature(text, node):
    lines=text.splitlines()
    chunk=[]
    for i in range(node.lineno-1, min(len(lines), getattr(node,'end_lineno',node.lineno)+10)):
        line=lines[i]
        if i==node.lineno-1:
            line=line[node.col_offset:]
        chunk.append(line.strip())
        s=' '.join(chunk)
        depth=0; in_str=None; esc=False
        for ch in s:
            if in_str:
                if esc: esc=False
                elif ch=='\\\\': esc=True
                elif ch==in_str: in_str=None
            else:
                if ch in ('\"',\"'\"): in_str=ch
                elif ch in '([{': depth+=1
                elif ch in ')]}': depth-=1
                elif ch==':' and depth==0:
                    header=s[:s.index(':')]
                    header=re.sub(r'"'^async'"\\s+def\\s+','',header)
                    header=re.sub(r'"'^def'"\\s+','',header)
                    return ' '.join(header.split())
    # fallback
    try:
        return f\"{node.name}({ast.unparse(node.args)})\"
    except Exception:
        return node.name+'(...)'

def info_for(p, base):
    text=read_text(p)
    try:
        tree=ast.parse(text)
    except SyntaxError as e:
        return {'path':str(p), 'rel':str(p.relative_to(base)) if p.is_relative_to(base) else str(p), 'doc':'PARSE ERROR: '+str(e), 'functions':[], 'keywords':[kw for kw in patterns if kw.lower() in text.lower()]} 
    doc=(ast.get_docstring(tree) or '').strip().splitlines()
    first=' '.join(doc[0].split()) if doc else ''
    funcs=[]
    for node in tree.body:
        if isinstance(node,(ast.FunctionDef, ast.AsyncFunctionDef)) and not node.name.startswith('_'):
            funcs.append(def_signature(text,node))
    return {'path':str(p), 'rel':str(p.relative_to(base)) if p.is_relative_to(base) else str(p), 'doc':first, 'functions':funcs, 'keywords':[kw for kw in patterns if kw.lower() in text.lower()]}

oa=list((root/'oa68k').glob('*.py'))
all_root=list(root.rglob('*.py'))
reg_py=list(reg.rglob('*.py')) if reg.exists() else []
matched_root=[]
for p in all_root:
    if p.parent == root/'oa68k':
        continue
    t=read_text(p)
    if any(kw.lower() in t.lower() for kw in patterns):
        matched_root.append(p)
matched_reg=[]
for p in reg_py:
    t=read_text(p)
    if any(kw.lower() in t.lower() for kw in patterns):
        matched_reg.append(p)
print(json.dumps({
  'oa_count':len(oa),
  'root_py_count':len(all_root),
  'matched_root_count':len(matched_root),
  'reg_py_count':len(reg_py),
  'matched_reg_count':len(matched_reg),
  'oa': [info_for(p, root) for p in sorted(oa)],
  'matched_root': [info_for(p, root) for p in sorted(matched_root)],
  'matched_reg': [info_for(p, reg.parent) for p in sorted(matched_reg)],
}, indent=2))
