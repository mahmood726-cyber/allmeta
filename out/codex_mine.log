        p = str(path).replace('\\\\','/').lower()
        if '/oa68k/' in p:
            return '0'
        return '-'
    return ','.join(sorted(r, key=lambda x:int(x)))


def row_for(p):
    text, tree, err = parse_tree(p)
    keys = sorted({m.group(0) for m in REGEX.finditer(text)}, key=str.lower)
    funcs = public_functions(text, tree) if tree else []
    return {
        'path': rel(p),
        'purpose': purpose(tree, err),
        'functions': funcs,
        'rung': rung_for(p, text),
        'keywords': ', '.join(asc(k) for k in keys) if keys else ''
    }


def md_escape(s):
    s = asc(s).replace('|', '\\\\|')
    s = s.replace('\\r',' ').replace('\\n',' ')
    return s


def functions_cell(funcs):
    if not funcs:
        return '(none)'
    return '<br>'.join('"'`'"' + md_escape(f) + '"'`'"' for f in funcs)


def table(rows, headers):
    out=[]
    out.append('| ' + ' | '.join(headers) + ' |')
    out.append('| ' + ' | '.join(['---']*len(headers)) + ' |')
    for r in rows:
        vals=[]
        for h in headers:
            vals.append(r.get(h,''))
        out.append('| ' + ' | '.join(md_escape(v) for v in vals) + ' |')
    return '\\n'.join(out)


def is_test_or_generated(p):
    s = rel(p).lower()
    parts = s.split('/')
    if 'tests' in parts or Path(s).name.startswith('test_'):
        return True
    if '/archive/release-snapshots/' in s or '/archive/release-evidence/' in s:
        return True
    if '/dev/build-scripts/' in s:
        return True
    if re.search(r'/(fix_|add_|upgrade_|optimize_|repair_|debug_|cleanup_|selenium_|browser_test|edge_browser|comprehensive_|full_app_test|editorial_|release_checklist|quick_js|user_flow)', s):
        return True
    return False

# File sets.
oa_files = sorted((ROOT/'oa68k').glob('*.py'))
all_worktree_py = sorted(p for p in ROOT.rglob('*.py') if '.git' not in p.parts)
reg_py = sorted(REG.rglob('*.py')) if REG.exists() else []

matched_worktree = []
for p in all_worktree_py:
    if p.parent == ROOT/'oa68k':
        continue
    if REGEX.search(read_text(p)):
        matched_worktree.append(p)
matched_reg = [p for p in reg_py if REGEX.search(read_text(p))]

# Row all oa68k. Row non-oa source candidates; list excluded separately.
oa_rows = [row_for(p) for p in oa_files]
source_matches = [p for p in matched_worktree if not is_test_or_generated(p)]
excluded_matches = [p for p in matched_worktree if is_test_or_generated(p)]
other_rows = [row_for(p) for p in source_matches]
reg_rows = [row_for(p) for p in matched_reg]

# Static write inventory.
json_write_rows = []

def src(text, node):
    try:
        return asc(ast.get_source_segment(text, node) or ast.unparse(node))
    except Exception:
        return ''


def const_assigns(tree, text):
    vals = {}
    if tree is None:
        return vals
    for node in tree.body:
        if isinstance(node, ast.Assign) and len(node.targets)==1 and isinstance(node.targets[0], ast.Name):
            nm = node.targets[0].id
            val = node.value
            if isinstance(val, ast.Constant) and isinstance(val.value, str):
                vals[nm] = val.value
            else:
                vals[nm] = src(text, val)
    return vals


def dict_keys_from_node(node):
    if isinstance(node, ast.Dict):
        ks=[]
        for k in node.keys:
            if isinstance(k, ast.Constant):
                ks.append(str(k.value))
            else:
                ks.append(src('', k) or '?')
        return ks
    return None


def collect_dict_assigns(tree, text):
    vals={}
    if tree is None:
        return vals
    for node in ast.walk(tree):
        if isinstance(node, ast.Assign) and isinstance(node.value, ast.Dict):
            keys=dict_keys_from_node(node.value)
            for t in node.targets:
                if isinstance(t, ast.Name):
                    vals[t.id]=keys
        if isinstance(node, ast.AnnAssign) and isinstance(node.target, ast.Name) and isinstance(node.value, ast.Dict):
            vals[node.target.id]=dict_keys_from_node(node.value)
    return vals


def keys_for_arg(arg, dicts):
    ks = dict_keys_from_node(arg)
    if ks is not None:
        return ks
    if isinstance(arg, ast.Name) and arg.id in dicts:
        return dicts[arg.id]
    return None


def mode_is_write(mode_node):
    if mode_node is None:
        return False
    if isinstance(mode_node, ast.Constant) and isinstance(mode_node.value, str):
        return any(ch in mode_node.value for ch in 'wa+')
    return False

write_files = sorted(set(oa_files + source_matches + matched_reg + all_worktree_py))
for p in write_files:
    text, tree, err = parse_tree(p)
    if tree is None:
        continue
    consts = const_assigns(tree, text)
    dicts = collect_dict_assigns(tree, text)
    for node in ast.walk(tree):
        if not isinstance(node, ast.Call):
            continue
        # append_jsonl(path, obj)
        fname = ''
        if isinstance(node.func, ast.Name):
            fname = node.func.id
        elif isinstance(node.func, ast.Attribute):
            fname = node.func.attr
        if fname == 'append_jsonl' and len(node.args) >= 2:
            path_expr = src(text, node.args[0])
            if any(x in path_expr.lower() for x in ['jsonl', 'ledger', 'seed', 'state', 'data']):
                ks = keys_for_arg(node.args[1], dicts)
                json_write_rows.append({
                    'module': rel(p), 'writer': 'append_jsonl', 'target': path_expr,
                    'record_keys': ', '.join(asc(k) for k in ks) if ks else 'unknown (non-literal record)'
                })
        # json.dump(obj, open(path, mode)) or json.dump(obj, fh)
        if fname == 'dump' and isinstance(node.func, ast.Attribute) and isinstance(node.func.value, ast.Name) and node.func.value.id == 'json' and node.args:
            target = 'file handle'
            if len(node.args) >= 2:
                targ = node.args[1]
                if isinstance(targ, ast.Call) and ((isinstance(targ.func, ast.Name) and targ.func.id == 'open') or (isinstance(targ.func, ast.Attribute) and targ.func.attr == 'open')):
                    if targ.args:
                        target = src(text, targ.args[0])
            ks = keys_for_arg(node.args[0], dicts)
            # Keep JSON-ish targets and file handles in modules with JSON constants.
            if 'json' in target.lower() or target == 'file handle':
                json_write_rows.append({
                    'module': rel(p), 'writer': 'json.dump', 'target': target,
                    'record_keys': ', '.join(asc(k) for k in ks) if ks else 'unknown (non-literal object or list)'
                })
        # open(path, \"w\"/\"a\") directly for json/jsonl-ish path.
        if fname == 'open' and node.args:
            mode = node.args[1] if len(node.args) > 1 else None
            if mode_is_write(mode):
                pexpr = src(text, node.args[0])
                low = pexpr.lower()
                if 'json' in low or 'ledger' in low or 'shard' in low or 'state' in low or 'manifest' in low:
                    json_write_rows.append({
                        'module': rel(p), 'writer': 'open(write/append)', 'target': pexpr,
                        'record_keys': 'unknown (raw write or handle)'
                    })
        # Path.write_text / write_bytes of json-ish path is too indirect; capture method name only if json nearby.
        if isinstance(node.func, ast.Attribute) and node.func.attr in ('write_text','write_bytes'):
            json_write_rows.append({
                'module': rel(p), 'writer': node.func.attr, 'target': src(text, node.func.value),
                'record_keys': 'unknown (path method)'
            })

# Deduplicate static write rows.
seen=set(); dedup=[]
for r in json_write_rows:
    key=(r['module'], r['writer'], r['target'], r['record_keys'])
    if key not in seen:
        seen.add(key); dedup.append(r)
json_write_rows=sorted(dedup, key=lambda r:(r['module'], r['target'], r['writer']))

# On-disk data inventory.
def first_jsonl_keys(p):
    line_count=0
    first=None
    with p.open('r', encoding='utf-8', errors='replace') as f:
        for line in f:
            if line.strip():
                line_count += 1
                if first is None:
                    try:
                        first=json.loads(line)
                    except Exception as e:
                        first={'__parse_error__': str(e)}
    keys=''
    if isinstance(first, dict):
        keys=', '.join(asc(k) for k in first.keys())
    elif first is not None:
        keys=type(first).__name__
    return line_count, keys


def json_keys(p):
    try:
        obj=json.loads(read_text(p))
    except Exception as e:
        return f'parse error: {e}'
    if isinstance(obj, dict):
        return 'top keys: ' + ', '.join(asc(k) for k in obj.keys())
    if isinstance(obj, list):
        if obj and isinstance(obj[0], dict):
            return 'list first keys: ' + ', '.join(asc(k) for k in obj[0].keys())
        return f'list len {len(obj)}'
    return type(obj).__name__


def data_rows_under(base):
    rows=[]
    if not base.exists():
        return rows
    for p in sorted(base.rglob('*')):
        if not p.is_file():
            continue
        suf=p.suffix.lower()
        lc='-'; keys='-'
        if suf == '.jsonl' or '.jsonl' in p.name.lower():
            try:
                n,k=first_jsonl_keys(p); lc=str(n); keys=k or '(no parseable first record)'
            except Exception as e:
                lc='error'; keys=asc(e)
        elif suf == '.json':
            keys=json_keys(p)
        rows.append({'file':rel(p), 'size_bytes':str(p.stat().st_size), 'line_count_if_jsonl':lc, 'first_record_keys':keys})
    return rows

data_rows = data_rows_under(ROOT/'oa68k'/'data')
reg_data_rows = data_rows_under(REG/'data') if REG.exists() else []

