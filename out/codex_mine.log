"C:\\WINDOWS\\System32\\WindowsPowerShell\\v1.0\\powershell.exe" -Command "@'
import ast
import json
import os
import re
import unicodedata
from pathlib import Path

ROOT = Path(r\"F:\\tr-build\\ladder\")
REG = Path(r\"F:\\allmeta\\regulatory\")
OUT = ROOT / \"out\" / \"REUSE-INVENTORY.md\"
PATTERNS = [
    'requests.', 'urllib', 'http', 'efetch', 'europepmc', 'ebi.ac.uk',
    'clinicaltrials.gov', 'accessdata.fda.gov', 'ema.europa.eu', 'pdfminer',
    'PyPDF', 'fitz', 'BeautifulSoup', 'lxml', 'table'
]
REGEX = re.compile('|'.join(re.escape(p) for p in PATTERNS), re.I)


def asc(s):
    if s is None:
        return \"\"
    s = str(s)
    repl = {
        '\\u2014':'-', '\\u2013':'-', '\\u2010':'-', '\\u2011':'-', '\\u2212':'-',
        '\\u2018':\"'\", '\\u2019':\"'\", '\\u201c':'\"', '\\u201d':'\"', '\\u2192':'->',
        '\\u21d2':'=>', '\\u2264':'<=', '\\u2265':'>=', '\\u2248':'~', '\\u00a0':' ',
        '\\ufeff':'', '\\u2026':'...', '\\u00d7':'x'
    }
    for k,v in repl.items():
        s = s.replace(k,v)
    s = unicodedata.normalize('NFKD', s).encode('ascii','ignore').decode('ascii')
    return s


def read_text(p):
    try:
        return p.read_text(encoding='utf-8')
    except UnicodeDecodeError:
        return p.read_text(encoding='utf-8-sig', errors='replace')
    except Exception as e:
        return f\"__READ_ERROR__ {e}\"


def rel(p):
    p = Path(p)
    try:
        return asc(str(p.relative_to(ROOT))).replace('\\\\','/')
    except Exception:
        try:
            return asc(str(p.relative_to(REG.parent))).replace('\\\\','/')
        except Exception:
            return asc(str(p)).replace('\\\\','/')


def parse_tree(p):
    text = read_text(p)
    try:
        return text, ast.parse(text), None
    except SyntaxError as e:
        return text, None, f\"parse error: {e}\"


def purpose(tree, err=None):
    if err:
        return err
    doc = ast.get_docstring(tree) or \"\"
    for line in doc.splitlines():
        line = ' '.join(line.split())
        if line:
            return asc(line)
    return \"(no module docstring)\"


def header_signature(text, node):
    lines = text.splitlines()
    chunk = []
    max_i = min(len(lines), (getattr(node, 'end_lineno', node.lineno) or node.lineno) + 15)
    for i in range(node.lineno - 1, max_i):
        line = lines[i]
        if i == node.lineno - 1:
            line = line[node.col_offset:]
        chunk.append(line.strip())
        s = ' '.join(chunk)
        depth = 0
        quote = None
        esc = False
        for idx, ch in enumerate(s):
            if quote:
                if esc:
                    esc = False
                elif ch == '\\\\':
                    esc = True
                elif ch == quote:
                    quote = None
            else:
                if ch in ('\"', \"'\"):
                    quote = ch
                elif ch in '([{':
                    depth += 1
                elif ch in ')]}':
                    depth -= 1
                elif ch == ':' and depth == 0:
                    h = s[:idx]
                    h = re.sub(r'"'^async'"\\s+def\\s+', '', h)
                    h = re.sub(r'"'^def'"\\s+', '', h)
                    return asc(' '.join(h.split()))
    try:
        return asc(f\"{node.name}({ast.unparse(node.args)})\")
    except Exception:
        return asc(node.name + \"(...)\")


def public_functions(text, tree):
    if tree is None:
        return []
    funcs = []
    for node in tree.body:
        if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)) and not node.name.startswith('_'):
            funcs.append(header_signature(text, node))
    return funcs


