        r.add('2')
    # Rung 3: Europe PMC / NCBI / PMC / DOI full text, JATS/XML/PDF/table extraction.
    if any(x in low for x in ['europe pmc', 'europepmc', 'ebi.ac.uk', 'efetch', 'pmc', 'pmcid', 'fulltext', 'full text', 'jats', 'bioc', 'doi', 'pdf', 'fitz', 'pypdf', 'pdfplumber', 'lxml', 'beautifulsoup', 'table-wrap']):
