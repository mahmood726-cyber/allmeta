  <ANALYSES_AND_DATA>
    <COMPARISON ID="01" NAME="SK vs tPA" GROUP_LABEL_1="SK" GROUP_LABEL_2="tPA">
      <DICH_OUTCOME ID="01_01" NAME="30-day mortality" EFFECT_MEASURE="OR"
                    GROUP_LABEL_1="SK" GROUP_LABEL_2="tPA">
        <DICH_SUBGROUP NAME="overall">
          <DICH_DATA STUDY_ID="GUSTO-1" EVENTS_1="1135" TOTAL_1="13780" EVENTS_2="1021" TOTAL_2="13746"/>
