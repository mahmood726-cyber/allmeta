    </COMPARISON>
    <COMPARISON ID="02" NAME="TNK vs tPA" GROUP_LABEL_1="TNK" GROUP_LABEL_2="tPA">
      <DICH_OUTCOME ID="02_01" NAME="30-day mortality" EFFECT_MEASURE="OR"
                    GROUP_LABEL_1="TNK" GROUP_LABEL_2="tPA">
        <DICH_DATA STUDY_ID="ASSENT-2" EVENTS_1="749" TOTAL_1="8461" EVENTS_2="753" TOTAL_2="8488"/>
