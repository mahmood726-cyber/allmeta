        <CONTINUOUS_DATA STUDY_ID="GUSTO-1" N_1="13780" MEAN_1="2.3" SD_1="1.1"
                                            N_2="13746" MEAN_2="2.0" SD_2="1.0"/>
        <CONTINUOUS_DATA STUDY_ID="GISSI-2" N_1="10372" MEAN_1="2.5" SD_1="1.2"
                                            N_2="10396" MEAN_2="2.1" SD_2="1.0"/>
