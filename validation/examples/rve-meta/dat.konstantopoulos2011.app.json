  "script": "# P15 reference recipe: robumeta CORR, small=TRUE; independent CR2 check.\nd <- data.frame(yi=c(-0.18,-0.22,0.23,-0.3,0.13,-0.26,0.19,0.32,0.45,0.38,0.29,0.16,0.65,0.36,0.6,0.08,0.04,0.19,-0.06,-0.18,0,0,-0.28,-0.04,-0.3,0.07,0,0.05,-0.08,-0.09,0.3,0.98,1.19,-0.07,-0.05,-0.01,0.02,-0.03,0,0.01,-0.1,0.5,0.66,0.2,0,0.05,0.07,-0.52,0.7,-0.03,0.27,-0.34,0.12,0.61,0.04,-0.05), vi=c(0.118,0.118,0.144,0.144,0.014,0.014,0.015,0.024,0.023,0.043,0.012,0.02,0.004,0.004,0.007,0.019,0.007,0.005,0.004,0.02,0.018,0.019,0.022,0.02,0.021,0.006,0.007,0.007,0.007,0.007,0.015,0.011,0.01,0.001,0.001,0.001,0.001,0.001,0.001,0.001,0.001,0.01,0.011,0.01,0.009,0.013,0.013,0.031,0.031,0.03,0.03,0.03,0.087,0.082,0.067,0.067), cl=c(\"11\",\"11\",\"11\",\"11\",\"12\",\"12\",\"12\",\"12\",\"18\",\"18\",\"18\",\"27\",\"27\",\"27\",\"27\",\"56\",\"56\",\"56\",\"56\",\"58\",\"58\",\"58\",\"58\",\"58\",\"58\",\"58\",\"58\",\"58\",\"58\",\"58\",\"71\",\"71\",\"71\",\"86\",\"86\",\"86\",\"86\",\"86\",\"86\",\"86\",\"86\",\"91\",\"91\",\"91\",\"91\",\"91\",\"91\",\"108\",\"108\",\"108\",\"108\",\"108\",\"644\",\"644\",\"644\",\"644\"))\n\nf <- robumeta::robu(yi ~ 1,\n  data=d, studynum=cl, var.eff.size=vi, modelweights='CORR', rho=0.8, small=TRUE)\ntab <- f$reg_table\ncr2 <- as.data.frame(clubSandwich::coef_test(f, vcov='CR2', test='Satterthwaite'))\nout <- list(k=nrow(d),clusters=length(unique(d$cl)),coefficients=nrow(tab),tau2=as.numeric(f$mod_info$tau.sq))\ncolumns <- c(estimate='b.r',se='SE',t='t',df='dfs',p='prob',ci_lo='CI.L',ci_hi='CI.U')\nclub_columns <- c(estimate='beta',se='SE',t='tstat',df='df_Satt',p='p_Satt')\nfor (i in seq_len(nrow(tab))) {\n  for (key in names(columns)) out[[paste('coef',i-1L,key,sep='.')]] <- tab[[columns[[key]]]][i]\n  for (key in names(club_columns)) out[[paste('club',i-1L,key,sep='.')]] <- cr2[[club_columns[[key]]]][i]\n}\ncat('ALMJSON:',jsonlite::toJSON(out,digits=NA,auto_unbox=TRUE,na='null'),'\\n',sep='')\n",
