  "script": "library(metafor)\ny <- c(-0.8893113339202054,-1.5853886572014306,-1.348073148299693,-1.4415511900213054,-0.2175473222112957,-0.786115585818864,-1.6208982235983924,0.011952333523841173,-0.4694176487381487,-1.3713448034727846,-0.33935882833839015,0.4459134005713783,-0.017313948216879493)\nv <- c(0.3255847650039613,0.19458112139814382,0.4153679653679654,0.020010031902247573,0.05121017216963086,0.006905618455908758,0.22301724757231517,0.0039615792978177295,0.056434210463248966,0.07302479361302892,0.01241221397155972,0.5325058452001528,0.0714046596839863)\nm <- rma(y,v,method='REML')\ne <- regtest(m,model='lm',predictor='sei',ret.fit=TRUE)\nb <- ranktest(y,vi=v)\nt <- trimfill(m,estimator='L0')\nout <- list(egger_lm_statistic=e$zval,egger_lm_p=e$pval,egger_lm_b0=as.numeric(coef(e$fit)[2]),egger_lm_limit=as.numeric(coef(e$fit)[1]),begg_tau=b$tau,begg_p=b$pval,trimfill_k0=t$k0,trimfill_side=t$side,trimfill_est=as.numeric(t$b),trimfill_se=t$se,trimfill_tau2=t$tau2)\nencode <- function(x) { if(length(x)!=1 || is.na(x)) return(\"null\"); if(is.character(x)) return(paste0(\"\\\"\",x,\"\\\"\")); if(!is.finite(x)) return(\"null\"); sprintf(\"%.17g\",x) }\ncat(\"ALMJSON:{\",paste(sprintf(\"\\\"%s\\\":%s\",names(out),vapply(out,encode,\"\")),collapse=\",\"),\"}\\n\",sep=\"\")",
