# Vendored third-party assets must be treated as binary so Git does not apply
# CRLF line-ending conversion on Windows clones. Without this, the byte hash of
# every vendored .min.js file changes on clone â€” Plotly's <script integrity=...>
# Subresource-Integrity check then blocks the script, and nma-pro-v2 (and any
# other app that uses SRI) silently fails to render any plot. Diagnosed
# 2026-05-26: Windows clone of plotly-2.35.0.min.js had `0d 0a` (CRLF) line
# endings, hash mismatch, browser blocked the script, every Plotly call failed.
*.min.js binary
*.umd.min.js binary
*.full.min.js binary

# Same defence for other CDN-fetched bundles we vendor.
shared/vendor/*.js binary
shared/vendor/**/*.js binary
hub/shared/vendor/*.js binary

# Binary fixtures (e.g. test PDFs) must never get CRLF conversion, which would
# corrupt the byte offsets / xref table and make the file unreadable on clone.
*.pdf binary

# Source files should keep platform-default line endings.
*.html text
*.css text
*.json text
*.md text
*.py text eol=lf
*.sh text eol=lf

# Validation manifests pin exact JSON bytes across Windows and Unix checkouts.
**/validate/corpus/*.json text eol=lf
nma-inconsistency/validate/corpus/*.json text eol=lf
nma-inconsistency/validate/corpus/reference.json text eol=lf

**/validate/plus/*.json text eol=lf

# Screen's hashes identify exact upstream model/data bytes on every platform.
screen/vendor/semantic/** -text -whitespace
screen/vendor/semantic/manifest.json text eol=lf
screen/benchmark/** -text -whitespace
screen/hybrid-core.js text eol=lf

# Screen head-to-head (screen/h2h): bytes pinned by sha256 in PROTOCOL/FREEZE; never convert line endings.
screen/h2h/** -text
screen/bench/** -text
# Model packs: every file is pinned by sha256 (FREEZE.md); never convert line endings.
screen/vendor/semantic/models/** -text
*.part00 binary
*.part01 binary
